# Copy to .env. These dummy values run the app against the local Firebase Emulator:
# a project ID starting with "demo-" needs no real Firebase project.
VITE_USE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-recipe-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-recipe-app
VITE_FIREBASE_APP_ID=demo-app

# At go-live (Epic 7) the real values come from Firebase console > Project settings > Your apps,
# shaped like:
#   VITE_USE_EMULATOR=false
#   VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
#   VITE_FIREBASE_PROJECT_ID=your-project-id
# The Firebase web config is public by design (it ships in the JS bundle). Security comes from
# firestore.rules plus the API key restriction, not from hiding these values.
