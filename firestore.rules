rules_version = '2';

// Membership (EPIC-1) plus document-shape validation, added per collection by later epics.
// See ADR-0002 and docs/project/project-setup.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email));
    }

    // Each collection gets an explicit rule. Do NOT add a {document=**} catch-all:
    // rules are OR-ed, so it would let members edit allowed_users. Anything not listed is denied.
    // Shape checks (US-2.4) guard against app bugs; the parsers and types guard each list item.
    // request.resource.data is the whole document after the write, so partial updates are
    // checked too. Recipes are archived, never deleted (delete is denied). A recipe's image is
    // deleted when its photo is removed (US-4.1, ADR-0001).
    function isValidRecipe(recipe) {
      return recipe.keys().hasOnly([
          'title', 'description', 'source', 'sourceUrl', 'yield', 'activeTime', 'totalTime',
          'tags', 'ingredients', 'instructions', 'thumbnail', 'hasImage', 'archived',
          'createdAt', 'updatedAt'])
        && recipe.title is string && recipe.title.size() > 0
        && recipe.description is string
        && recipe.source is string
        && recipe.sourceUrl is string
        && recipe.yield is string
        && recipe.activeTime is string
        && recipe.totalTime is string
        && recipe.tags is list
        && recipe.ingredients is list
        && recipe.instructions is list
        // Data URL characters; matches THUMBNAIL.maxChars in src/utils/imageCompressor.ts.
        && (recipe.thumbnail == null
            || (recipe.thumbnail is string && recipe.thumbnail.size() <= 60000))
        && recipe.hasImage is bool
        && recipe.archived is bool
        && recipe.createdAt is timestamp
        && recipe.updatedAt is timestamp;
    }

    function isValidRecipeImage(image) {
      // Matches FULL_IMAGE.maxChars in src/utils/imageCompressor.ts (the document limit is 1 MiB).
      return image.keys().hasOnly(['data'])
        && image.data is string && image.data.size() <= 900000;
    }

    match /recipes/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && isValidRecipe(request.resource.data);
    }
    match /recipe_images/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && isValidRecipeImage(request.resource.data);
      allow delete: if isMember();
    }
    // A Plan day (US-5.1, ADR-0006). Rules can't check each entry in the list; src/data/menu.ts
    // does. Days are never deleted: removing the last entry leaves an empty list.
    function isValidMenuDay(day) {
      return day.keys().hasOnly(['entries', 'updatedAt'])
        && day.entries is list && day.entries.size() <= 20
        && day.updatedAt is timestamp;
    }

    match /menu_days/{date} {
      allow read: if isMember();
      allow create, update: if isMember()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isValidMenuDay(request.resource.data);
    }

    // The one shared grocery list (US-6.3, ADR-0008). Rules can't check each line;
    // src/data/groceries.ts does. `ticked` may be missing until the first tick (adding lines to
    // a missing list creates it with arrayUnion). Cleared, never deleted.
    function isValidGroceryList(groceries) {
      return groceries.keys().hasOnly(['lines', 'ticked', 'updatedAt'])
        && groceries.lines is list && groceries.lines.size() <= 600
        && (!('ticked' in groceries) || (groceries.ticked is list && groceries.ticked.size() <= 600))
        && groceries.updatedAt is timestamp;
    }

    match /grocery_lists/{listId} {
      allow read: if isMember();
      allow create, update: if isMember()
        && listId == 'current'
        && isValidGroceryList(request.resource.data);
    }

    // Signed-in users may read their own entry (so the app can tell members from non-members).
    // Nobody can write here from the app: members are added by hand in the Firebase console.
    match /allowed_users/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;
      allow list, write: if false;
    }
  }
}
